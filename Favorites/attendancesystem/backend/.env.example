# ─── Server ───────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── JWT (issued by this backend) ─────────────────────────
# Use a strong random string: openssl rand -hex 64
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ─── App ──────────────────────────────────────────────────
# Primary frontend URL — used when generating invite/QR links in emails.
APP_URL=http://localhost:5173

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Defaults to APP_URL when not set. Add extra origins here:
# CORS_ORIGINS=http://localhost:5173,https://myapp.com
CORS_ORIGINS=http://localhost:5173

# ─── Resend (email) ───────────────────────────────────────
RESEND_API_KEY=re_BgiFeNrH_KvLKpT2A3w8xDdNrz43NUkGH
EMAIL_FROM=onboarding@farmwithirene.online
EMAIL_FROM_NAME=attendtrack

# ─── Cloudinary (signatures, photos, QR code images) ──────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=attendance-platform

# ─── Supabase Storage (Word templates & generated docs) ───
DOCUMENT_BUCKET=documents
TEMPLATE_BUCKET=templates

# ─── OTP ──────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
